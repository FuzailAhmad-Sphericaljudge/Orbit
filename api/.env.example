DATABASE_URL=postgresql+psycopg://orbit:orbit_local_only@localhost:5432/orbit
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_AREA=US
AGORA_AGENT_UID=1
ORBIT_DEFAULT_LANGUAGE=en-US
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_JWT_ISSUER=orbit
AUTH_JWT_AUDIENCE=orbit-api
OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_ROLES_CLAIM=roles
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
PAGERDUTY_API_TOKEN=
PAGERDUTY_FROM_EMAIL=
PAGERDUTY_SERVICE_ID=
MONITORING_WEBHOOK_URL=
MONITORING_WEBHOOK_TOKEN=
# Grafana Cloud Prometheus query endpoint, e.g. https://prometheus-prod-xx.grafana.net/api/prom
# Use a read-only MetricsPublisher/metrics-read access-policy token; do not commit the real values.
PROMETHEUS_BASE_URL=
PROMETHEUS_USERNAME=
PROMETHEUS_BEARER_TOKEN=
PRODUCTION_LEARNING_ENABLED=false
TELEMETRY_COLLECTOR_ENABLED=false
TELEMETRY_COLLECTION_INTERVAL_SECONDS=60
TELEMETRY_COLLECTION_WINDOW_MINUTES=20
TELEMETRY_QUERY_CATALOG_JSON={"queries":[]}
FORECAST_EVALUATION_GRACE_MINUTES=2
INTEGRATION_TIMEOUT_SECONDS=10
VISION_ANALYSIS_URL=
VISION_ANALYSIS_TOKEN=
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
AUTO_CREATE_SCHEMA=true
RATE_LIMIT_REQUESTS_PER_MINUTE=240
MAX_REQUEST_BODY_BYTES=2000000
RETENTION_DAYS=90
JOB_MAX_RETRIES=5
JOB_STREAM_MAX_LENGTH=10000
TRUSTED_HOSTS=localhost,127.0.0.1
AUTH_JWT_SECRET_FILE=
DATABASE_URL_FILE=
REDIS_URL_FILE=
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_FILE=
